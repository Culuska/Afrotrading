# PostgreSQL connection. On Vercel, use the pooled URL from Neon / Prisma Postgres here.
DATABASE_URL="postgresql://postgres@localhost:5433/mcr"
# Direct (non-pooled) URL used by `prisma migrate` (Vercel + Neon sets this automatically).
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5433/mcr"
# Long random string, e.g. `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string"

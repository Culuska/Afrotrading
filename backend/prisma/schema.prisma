// AfroTrading - Gold Signal Provider Platform
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// Enums
// ------------------------------

enum Role {
  FREE
  VIP
  ADMIN
}

enum MembershipPlan {
  FREE
  VIP_MONTHLY
  VIP_LIFETIME
}

enum PaymentProvider {
  CRYPTO
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SignalDirection {
  BUY
  SELL
}

enum SignalStatus {
  PENDING
  RUNNING
  HIT_TP1
  HIT_TP2
  HIT_TP3
  STOPPED_OUT
  CLOSED
  CANCELLED
}

enum EducationType {
  VIDEO
  AUDIO
  PDF
  IMAGE
  ARTICLE
}

enum EducationCategory {
  MARKET_ANALYSIS
  TRADING_PSYCHOLOGY
  RISK_MANAGEMENT
  GOLD_ANALYSIS
  FOREX_EDUCATION
  VIDEO_LESSONS
  ARTICLES
  WEEKLY_ANALYSIS
  TRADING_JOURNAL
}

enum AnalysisTimeframe {
  DAILY
  WEEKLY
  MONTHLY
}

enum AnalysisType {
  TECHNICAL
  FUNDAMENTAL
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  PDF
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  PUSH
}

// ------------------------------
// Models
// ------------------------------

model User {
  id                    String    @id @default(cuid())
  fullName              String
  email                 String    @unique
  phone                 String?
  country               String?
  passwordHash          String
  role                  Role      @default(FREE)
  membership            MembershipPlan @default(FREE)
  membershipExpiresAt   DateTime?
  status                UserStatus @default(PENDING_VERIFICATION)

  emailVerified         Boolean   @default(false)
  emailVerifyToken      String?
  passwordResetToken    String?
  passwordResetExpires  DateTime?

  twoFactorEnabled      Boolean   @default(false)
  twoFactorSecret       String?

  telegramChatId        String?
  telegramUsername      String?
  telegramJoined        Boolean   @default(false)

  referralCode          String    @unique @default(cuid())
  referredById          String?
  referredBy            User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals             User[]    @relation("Referrals")

  notifyEmail           Boolean   @default(true)
  notifyTelegram        Boolean   @default(true)
  notifyPush            Boolean   @default(false)

  savedSignals          SavedSignal[]
  educationProgress     EducationProgress[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  contactMessages       ContactMessage[]
  payments              Payment[]
  reviewedPayments      Payment[] @relation("PaymentReviewer")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model Signal {
  id            String          @id @default(cuid())
  signalNumber  Int             @unique @default(autoincrement())
  pair          String          @default("XAUUSD")
  direction     SignalDirection
  entryPrice    Decimal         @db.Decimal(12, 4)
  stopLoss      Decimal         @db.Decimal(12, 4)
  takeProfit1   Decimal         @db.Decimal(12, 4)
  takeProfit2   Decimal?        @db.Decimal(12, 4)
  takeProfit3   Decimal?        @db.Decimal(12, 4)
  riskPercent   Decimal?        @db.Decimal(5, 2)
  status        SignalStatus    @default(PENDING)
  resultPips    Decimal?        @db.Decimal(10, 2)
  riskReward    Decimal?        @db.Decimal(6, 2)
  profitUsd     Decimal?        @db.Decimal(12, 2)
  chartImageUrl String?
  notes         String?

  isPublished   Boolean         @default(false)
  isArchived    Boolean         @default(false)
  scheduledFor  DateTime?
  publishedAt   DateTime?
  closedAt      DateTime?

  vipOnly       Boolean         @default(false)

  telegramSent      Boolean     @default(false)
  telegramMessageId Int?
  telegramIsPhoto   Boolean     @default(false)

  savedBy       SavedSignal[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([pair])
  @@index([createdAt])
  @@map("signals")
}

model SavedSignal {
  id        String   @id @default(cuid())
  userId    String
  signalId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, signalId])
  @@map("saved_signals")
}

model EducationContent {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  type        EducationType
  category    EducationCategory
  videoUrl    String?
  youtubeUrl  String?
  fileUrl     String?
  imageUrl    String?
  body        String?
  featured    Boolean           @default(false)
  vipOnly     Boolean           @default(false)
  published   Boolean           @default(true)

  progress    EducationProgress[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([category])
  @@index([type])
  @@map("education_content")
}

model EducationProgress {
  id          String            @id @default(cuid())
  userId      String
  contentId   String
  completed   Boolean           @default(false)
  progressPct Int               @default(0)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     EducationContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  updatedAt   DateTime          @updatedAt

  @@unique([userId, contentId])
  @@map("education_progress")
}

model MarketAnalysis {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  summary     String?
  body        String?
  timeframe   AnalysisTimeframe
  type        AnalysisType
  pair        String            @default("XAUUSD")
  chartImageUrl String?
  videoUrl    String?
  vipOnly     Boolean           @default(false)
  published   Boolean           @default(true)
  scheduledFor DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([timeframe])
  @@index([type])
  @@map("market_analysis")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  country   String?
  avatarUrl String?
  message   String
  rating    Int      @default(5)
  featured  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  price       Decimal  @db.Decimal(10, 2)
  billingCycle String  @default("month") // month | lifetime | free
  features    Json
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pricing_plans")
}

model Payment {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  provider      PaymentProvider
  plan          MembershipPlan
  amountUsd     Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)

  // Crypto (NowPayments)
  nowPaymentsId String?
  invoiceUrl    String?
  payCurrency   String?

  // Manual mobile money (EVC Plus / Zaad)
  mobileNumber    String?
  transactionRef  String?
  proofImageUrl   String?
  rejectionReason String?

  reviewedById  String?
  reviewedBy    User?           @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model MediaAsset {
  id           String    @id @default(cuid())
  url          String
  publicId     String?
  type         MediaType
  fileName     String?
  sizeBytes    Int?
  uploadedById String?

  createdAt    DateTime  @default(now())

  @@map("media_assets")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  title     String
  body      String?
  read      Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType])
  @@map("audit_logs")
}

model SiteSettings {
  id            String   @id @default("singleton")
  logoUrl       String?
  heroBannerUrl String?
  heroTitle     String?
  heroSubtitle  String?
  seoTitle      String?
  seoDescription String?
  ogImageUrl    String?
  telegramGroupUrl   String?
  telegramChannelUrl String?
  whatsappNumber     String?
  contactEmail       String?
  contactPhone       String?
  facebookUrl   String?
  instagramUrl  String?
  twitterUrl    String?
  youtubeUrl    String?
  updatedAt     DateTime @updatedAt

  @@map("site_settings")
}

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/afrotrading?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_CHAT_ID=
TELEGRAM_GROUP_URL=https://t.me/afrotrading_community
TELEGRAM_CHANNEL_URL=https://t.me/afrotrading_vip

# Email (Resend HTTP API - most hosts block outbound SMTP ports, so this is used instead of SMTP)
RESEND_API_KEY=
EMAIL_FROM=AfroTrading <onboarding@resend.dev>

# Social auto-posting (Zapier "Catch Hook" webhook URLs - each is its own Zap: Webhook -> X / Instagram)
ZAPIER_X_WEBHOOK_URL=
ZAPIER_INSTAGRAM_WEBHOOK_URL=
